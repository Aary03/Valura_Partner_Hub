# Valura Partner Activation Hub — environment
# Copy to .env.local for local development. In production set these in the
# Vercel dashboard (Project → Settings → Environment Variables).
# .env.local is gitignored. Never commit real values.

# --- Zoho Sign -------------------------------------------------------------
# Self-client or server-based app in the Zoho API console, scoped to
# ZohoSign.documents.ALL and ZohoSign.account.READ.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
# Data centre the Zoho account lives in: com | eu | in | au | jp | ca | sa
ZOHO_SIGN_DC=in

# --- Resend ----------------------------------------------------------------
# Used only when a human clicks Send on a drafted message. The Hub never
# dispatches on its own.
RESEND_API_KEY=
RESEND_FROM="Valura Partners <partners@valura.ai>"

# --- Hub -------------------------------------------------------------------
# Shared secret required by every /api route. Set it to a long random string
# and enter the same value in the Hub under Setup → Connections.
# Without it the deployed API is open to anyone who finds the URL.
HUB_API_KEY=

# Origin the PDF renderer loads the print surface from. Leave blank on Vercel —
# it is derived from the request. Set it only when running the API somewhere
# other than where the static site is served.
HUB_ORIGIN=
